# Laisser les deux variables vides pour essayer le mode DEMO (stockage local non privé).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Clé publique VAPID, produite avec : npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Variables SECRÈTES à configurer UNIQUEMENT sur Vercel (jamais VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@example.com
CRON_SECRET=
